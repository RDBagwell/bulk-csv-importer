[mysqld]
# LOAD DATA LOCAL INFILE lets a client make the server read files from the
# client machine. The app never uses it, so it stays off (see SECURITY.md).
# This is also MySQL 8's default; it is set here to make the choice explicit.
local_infile = 0

# The only change from MySQL 8.4 defaults, and the setting the benchmarks in
# docs/BENCHMARKS.md were run with. Everything else (redo log, flush policy,
# binary log) is left at its default so the numbers are not flattered.
innodb_buffer_pool_size = 1G
