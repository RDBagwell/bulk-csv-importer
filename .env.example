APP_NAME="Bulk CSV Importer"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker Compose overrides DB_HOST/REDIS_HOST/MAIL_HOST with the service names.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=importer
DB_USERNAME=importer
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root-secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="importer@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Importer (see config/importer.php) -------------------------------------
# One upload limit for nginx, PHP and Laravel. UPLOAD_LIMIT feeds nginx's
# client_max_body_size and PHP's upload_max_filesize/post_max_size in Docker;
# keep it a little above IMPORTER_MAX_UPLOAD_KB for multipart overhead.
UPLOAD_LIMIT=1100M
IMPORTER_MAX_UPLOAD_KB=1048576
IMPORTER_UPLOADS_PER_MINUTE=10
IMPORTER_RETENTION_DAYS=7

# parallel | sequential | auto ("auto" goes parallel at IMPORTER_PARALLEL_MIN_BYTES).
IMPORTER_MODE=parallel
IMPORTER_PARALLEL_MIN_BYTES=2097152
IMPORTER_CHUNK_BYTES=2097152
IMPORTER_INSERT_BATCH_SIZE=2000

IMPORTER_QUEUE_CONNECTION=imports
IMPORTER_QUEUE=imports
IMPORTER_WORKERS=4
IMPORTER_JOB_TRIES=3
IMPORTER_JOB_TIMEOUT=3600
# Must be longer than IMPORTER_JOB_TIMEOUT.
IMPORTER_RETRY_AFTER=3660

IMPORTER_MAX_STORED_ERRORS=10000
IMPORTER_ERROR_THRESHOLD_PERCENT=5
IMPORTER_ERROR_THRESHOLD_MIN_ROWS=1000

# Comma-separated e-mails allowed to open /horizon outside APP_ENV=local.
HORIZON_ADMINS=
